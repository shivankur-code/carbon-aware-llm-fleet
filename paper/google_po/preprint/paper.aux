\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Left: change in 6-year lifecycle carbon of the reference fleet relative to the no-reuse fleet (failures counted), by component, for the failure-blind plan, the reliability-aware plan, and the latter with in-place or geographic cascading; dots mark the net change. Right: $X$, failure-blind and reliability-aware savings for single-grid fleets. GPU throughput, power and CXL slowdown are placeholders.}}{21}{figure.3}\protected@file@percent }
\newlabel{fig:ladder}{{3}{21}{Left: change in 6-year lifecycle carbon of the reference fleet relative to the no-reuse fleet (failures counted), by component, for the failure-blind plan, the reliability-aware plan, and the latter with in-place or geographic cascading; dots mark the net change. Right: $X$, failure-blind and reliability-aware savings for single-grid fleets. GPU throughput, power and CXL slowdown are placeholders}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Reference-fleet saving versus a multiplier $m$ on reused-part failure rates beyond the age effect (log scale). $X$ is flat; the reliability-aware plan still reuses at $m=5$ and has stopped by $m=8$ (no sweep points in between, so the crossover lies in $(5,8]$; it cannot do worse than no reuse by construction); the failure-blind plan crosses zero near $m \approx 2.1$ (interpolated), a value that mostly reflects the cost of ignoring drains (Section~\ref {sec:fleet}).}}{21}{figure.4}\protected@file@percent }
\newlabel{fig:breakeven}{{4}{21}{Reference-fleet saving versus a multiplier $m$ on reused-part failure rates beyond the age effect (log scale). $X$ is flat; the reliability-aware plan still reuses at $m=5$ and has stopped by $m=8$ (no sweep points in between, so the crossover lies in $(5,8]$; it cannot do worse than no reuse by construction); the failure-blind plan crosses zero near $m \approx 2.1$ (interpolated), a value that mostly reflects the cost of ignoring drains (Section~\ref {sec:fleet})}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Additional saving (pp) from cascading previous-generation GPU hosts to the batch tier versus their batch work per joule relative to current-generation hosts (dotted line: energy parity). $Z$: in-place; $Z_g$: geographic cascading to the clean-grid region. Cascading pays only near energy parity; geographic cascading adds further savings once cascading pays.}}{22}{figure.5}\protected@file@percent }
\newlabel{fig:cascade}{{5}{22}{Additional saving (pp) from cascading previous-generation GPU hosts to the batch tier versus their batch work per joule relative to current-generation hosts (dotted line: energy parity). $Z$: in-place; $Z_g$: geographic cascading to the clean-grid region. Cascading pays only near energy parity; geographic cascading adds further savings once cascading pays}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces One-at-a-time sensitivity of the node-level reuse saving (mixed grid, LC tier). Bars start at the base saving (0.93\%, solid line) and show the saving with the parameter at the low (blue) and high (orange) end; the dashed line marks zero. The CXL throughput multiplier has by far the largest swing and is the dominant factor in the sign of the saving, but grid intensity and the reuse host's peak-power delta can also flip it within their ranges (Table~\ref {tab:breakeven}).}}{22}{figure.6}\protected@file@percent }
\newlabel{fig:tornado}{{6}{22}{One-at-a-time sensitivity of the node-level reuse saving (mixed grid, LC tier). Bars start at the base saving (0.93\%, solid line) and show the saving with the parameter at the low (blue) and high (orange) end; the dashed line marks zero. The CXL throughput multiplier has by far the largest swing and is the dominant factor in the sign of the saving, but grid intensity and the reuse host's peak-power delta can also flip it within their ranges (Table~\ref {tab:breakeven})}{figure.6}{}}
