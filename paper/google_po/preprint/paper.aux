\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Overview of the reliability-aware lifecycle model. SKUs, component reliability (Weibull hazards, delayed renewal), regional grids and demand, and reused-part pools feed a multi-period LP over cohorts that each quarter decides to buy, keep, retire, cascade LC$\rightarrow $BATCH (in place or to a clean-grid region) or lease. An outer Monte Carlo loop models drained nodes as M/G/$\infty $ occupancy and adds reserve until $P(\text  {short})\le \varepsilon $ in every region-quarter.}}{4}{figure.1}\protected@file@percent }
\newlabel{fig:overview}{{1}{4}{Overview of the reliability-aware lifecycle model. SKUs, component reliability (Weibull hazards, delayed renewal), regional grids and demand, and reused-part pools feed a multi-period LP over cohorts that each quarter decides to buy, keep, retire, cascade LC$\rightarrow $BATCH (in place or to a clean-grid region) or lease. An outer Monte Carlo loop models drained nodes as M/G/$\infty $ occupancy and adds reserve until $P(\text {short})\le \varepsilon $ in every region-quarter}{figure.1}{}}
